;; tools/gen_tx.cljk — regenerates data/datascript-tx.edn from
;; `ordinance.facts/catalog`. data/ is a projection, never hand-edited:
;; run `clojure -M -i tools/gen_tx.cljk` after changing the catalog.
;;
;; Before 2026-09-01 this file did not exist and data/datascript-tx.edn was
;; maintained by hand alongside the catalog. Two copies of the same facts
;; kept in step by discipline is a drift waiting to happen, and a consumer
;; querying the tx-data would have seen something this repo never asserted.
;; `test/ordinance/facts_test.cljk` now fails if the two disagree.
(require '[ordinance.facts :as facts]
         '[clojure.pprint :as pp])

(def rows
  (mapv (fn [o] (update o :ordinance/topic #(vec (sort %))))
        (facts/spec-basis "panama-city")))

(spit "data/datascript-tx.edn"
      (str ";; data/datascript-tx.edn — DataScript tx-data derived from src/ordinance/facts.cljk\n"
           ";; `ordinance.facts/catalog` (ADR-2607141700). Same shape as sibling files.\n"
           ";;\n"
           ";; GENERATED — do not hand-edit. Regenerate with:\n"
           ";;   clojure -M -i tools/gen_tx.cljk\n"
           ";; `test/ordinance/facts_test.cljk` fails if this file drifts from the catalog.\n\n"
           (with-out-str (pp/pprint rows))))
(println "wrote data/datascript-tx.edn —" (count rows) "entries")
